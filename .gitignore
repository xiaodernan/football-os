# dependencies
node_modules/
.next*/
dist/
build/
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# env & secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key

# local databases / storage
*.sqlite3
*.db
*.db-shm
*.db-wal
data/uploads/
storage/

# tooling
coverage/
.nyc_output/
storybook-static/
*.tsbuildinfo
.DS_Store
Thumbs.db

# visual QA captures — regenerated by `node scripts/visual-qa.mjs`, see docs/screenshots/README.md
docs/screenshots/*.png

# M5 video uploads and their sampled frames (local scratch space, never committed)
var/

# local scratch logs from agents working in this tree (never committed)
.scratch/
.qoder/
*.log
