# Copy to apps/web/.env.local
# FastAPI origin used by server components and by the /api/v1/* cookie proxy.
API_INTERNAL_URL=http://127.0.0.1:8731
# Must match apps/api REFRESH_TOKEN_TTL_DAYS (cookie lifetime only).
REFRESH_TOKEN_TTL_DAYS=30
# Public origin written into canonical URLs, OpenGraph URLs, sitemap.xml and robots.txt.
# Leave at the dev value locally; set it to the deployed host in production.
SITE_URL=http://127.0.0.1:3210
# The address the *web server* uses to reach the Spring Cloud edge (/plane console reads
# /edge/breaker, /edge/limits and /edge/lb through it). Not a public URL — compose name in
# deployment (http://edge:8080), localhost:8080 for a local edge. See docs/runbooks/service_plane.md §6.
# EDGE_URL=http://edge:8080
