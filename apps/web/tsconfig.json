{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-buildcheck/types/**/*.ts",
    ".next-carry/types/**/*.ts",
    ".next-ci/types/**/*.ts",
    ".next-club/types/**/*.ts",
    ".next-creator/types/**/*.ts",
    ".next-dev/types/**/*.ts",
    ".next-fx/types/**/*.ts",
    ".next-i18n/types/**/*.ts",
    ".next-i18n/types/**/*.ts",
    ".next-i18n10/types/**/*.ts",
    ".next-i18n11/types/**/*.ts",
    ".next-i18n12/types/**/*.ts",
    ".next-i18n13/types/**/*.ts",
    ".next-i18n14/types/**/*.ts",
    ".next-i18n15/types/**/*.ts",
    ".next-i18n16/types/**/*.ts",
    ".next-i18n17/types/**/*.ts",
    ".next-i18n18/types/**/*.ts",
    ".next-i18n19/types/**/*.ts",
    ".next-i18n2/types/**/*.ts",
    ".next-i18n20/types/**/*.ts",
    ".next-i18n3/types/**/*.ts",
    ".next-i18n4/types/**/*.ts",
    ".next-i18n5/types/**/*.ts",
    ".next-i18n6/types/**/*.ts",
    ".next-i18n7/types/**/*.ts",
    ".next-i18n8/types/**/*.ts",
    ".next-i18n9/types/**/*.ts",
    ".next-ledger/types/**/*.ts",
    ".next-market/types/**/*.ts",
    ".next-tac/types/**/*.ts",
    ".next-timeline/types/**/*.ts",
    ".next-verify/types/**/*.ts",
    ".next-walks/types/**/*.ts",
    ".next-walks2/types/**/*.ts",
    ".next-walks3/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-m12trace/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "scripts"
  ]
}
