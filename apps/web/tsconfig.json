{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-buildcheck/types/**/*.ts",
    ".next-carry/types/**/*.ts",
    ".next-ci/types/**/*.ts",
    ".next-club/types/**/*.ts",
    ".next-dev/types/**/*.ts",
    ".next-fx/types/**/*.ts",
    ".next-i18n/types/**/*.ts",
    ".next-ledger/types/**/*.ts",
    ".next-market/types/**/*.ts",
    ".next-tac/types/**/*.ts",
    ".next-timeline/types/**/*.ts",
    ".next-verify/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-i18n/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "scripts"
  ]
}
