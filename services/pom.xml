<?xml version="1.0" encoding="UTF-8"?>
<!--
  The service plane (ROADMAP Phase 11). Three modules and one rule: no football rule lives here.

  The Python core in apps/api stays canonical — it computes every figure, judges every question and
  publishes every sentence about a club, a player or a season. These modules give that core the shape a
  platform has in production: a registry that says where a service is, a config server that keeps
  configuration reviewable as files, and an edge that resolves, traces and protects the way in.

  Versions are pinned to what the local Maven repository holds (Spring Boot 3.5.16 / Spring Cloud
  2025.0.3) so `mvn -o package` is a real gate with no network behind it.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>os.football</groupId>
  <artifactId>service-plane</artifactId>
  <version>0.1.0</version>
  <packaging>pom</packaging>

  <name>FOOTBALL OS service plane</name>
  <description>Registry, config server and edge gateway around the canonical Python core</description>

  <modules>
    <module>registry</module>
    <module>config</module>
    <module>edge</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <spring-cloud.version>2025.0.3</spring-cloud.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
